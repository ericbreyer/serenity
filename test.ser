fn main() -> int {
                var sum: int = 0;
                for (var i: int = 0; i < 10; i = i + 1) {
                    printf("i: %d\n", i);
                    if (i % 2 == 0) {
                        continue;
                    }
                    sum = sum + i;
                }
                return sum;
            }