include "arena_alloc.ser";

let arena: struct Arena;

type generator interface {
    next: fn() -> int,
};

type nat_gen struct {
    i: int,
} implements generator;

fun (self : * struct nat_gen) next() -> int {
    let i = self->i;
    self->i = i + 1;
    return i;
}

type identity struct {
    gen: impl generator,
} implements generator;

fun (self : * struct identity) next() -> int {
    return self->gen.next();
}

type<C> filter struct {
    gen: impl generator,
    pred: fn[C](int) -> bool,
} implements generator;

fun (self : * struct filter) next() -> int {
    let pred = self->pred;
    var i = self->gen.next();
    while (!pred(i)) {
        i = self->gen.next();
    }
    return i;
}

type seive struct {
    gen: impl generator,
} implements generator;

fun divides(a: int, b: int) -> bool {
    return float(a / b) == #a/#b;
}
fun<C> not(pred: fn[C](int) -> bool) -> fn[fn[C](int) -> bool](int) -> bool {
    return lambda[pred](x: int) -> bool {
        return !pred(x);
    };
}

fun (self : * struct seive) next() -> int {
    var gen = self->gen;
    var i = gen.next();

    let pred = divides(_, i);
    let pred = not(pred);
    let filter: *struct filter = arena.alloc(sizeof(struct filter));
    *filter = struct filter { gen: self->gen, pred: pred };
    self->gen = filter_impl_generator(filter);
    return i;
}

const NPRIMES = 100;

fn main() -> int {
    arena = create_arena(); 
    var nats = struct nat_gen { i: 2 };

    var gen = struct seive { gen: nat_gen_impl_generator(&nats)};

    var prod = 1;
    for(var i = 0; i < NPRIMES; i = i + 1) {
        let p = gen.next();
        prod = prod * p;
    }

    arena.destroy();
    return prod;
}