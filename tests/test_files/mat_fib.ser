type twovec struct {
    x: int,
    y: int,
};

type twoxtwomatrix struct {
    a : struct twovec,
    b : struct twovec,
};

fn matMult(ma: *struct twoxtwomatrix, mb: *struct twoxtwomatrix) -> struct twoxtwomatrix {
    return struct twoxtwomatrix{
        a: struct twovec {
            x: ma->a.x * mb->a.x + ma->a.y * mb->b.x,
            y: ma->a.x * mb->a.y + ma->a.y * mb->b.y,
        },
        b: struct twovec {
            x: ma->b.x * mb->a.x + ma->b.y * mb->b.x,
            y: ma->b.x * mb->a.y + ma->b.y * mb->b.y,
        },
    };
}

fn fib_mat(n: int) -> struct twoxtwomatrix {
    let baseMat = struct twoxtwomatrix{a: struct twovec { x: 1, y: 1 }, b: struct twovec { x: 1, y: 0 }};
    let identity = struct twoxtwomatrix{a: struct twovec { x: 1, y: 0 }, b: struct twovec { x: 0, y: 1 }};
    if(n == 0) {
        return identity;
    }
    if (n <= 1) {
        return baseMat;
    }

    let half = fib_mat(n / 2);
    let extra = (n % 2 == 0) ? identity : baseMat;

    let halfSquared = matMult(&half, &half);
    return matMult(&extra, &halfSquared);
}

fn fib(n: int) -> int {
    return fib_mat(n).b.x;
}

fn main() -> int {
    let ret = 0;
    for (let i = 0; i < 30; i = i + 1) {
        let f = fib(i);
        ret = ret + f;
    }
    return ret;
}